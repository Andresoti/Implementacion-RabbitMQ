{
  "version": 1,
  "projects": {
    "pedidos360": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/pedidos360"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "local": {
              "optimization": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "assets/config.json"
                  ]
                },
                {
                  "glob": "config.json",
                  "input": "local-config",
                  "output": "assets"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "pedidos360:build:development"
            },
            "local": {
              "buildTarget": "pedidos360:build:local"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "pedidos360:build:development"
          }
        }
      }
    }
  }
}
